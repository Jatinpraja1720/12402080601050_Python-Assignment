n, k, m = map(int, input().split())

students = []
semester_students = {}
subject_topper = {}

for _ in range(n):
    data = input().split()

    enrollment = data[0]
    name = data[1]
    semester = int(data[2])
    cpi = float(data[3])
    marks = list(map(int, data[4:]))

    student = (enrollment, name, semester, cpi, marks)
    students.append(student)

    if semester not in semester_students:
        semester_students[semester] = []

    semester_students[semester].append(student)

    for i in range(m):
        subject = "S" + str(i + 1)

        if subject not in subject_topper:
            subject_topper[subject] = []

        subject_topper[subject].append((marks[i], enrollment))


# Print top K students semester-wise
for semester in sorted(semester_students):
    group = semester_students[semester]

    group.sort(
        key=lambda x: (-x[3], -sum(x[4]) / m, x[0])
    )

    print("Semester " + str(semester) + ":", end=" ")

    top_students = group[:k]
    print(" ".join(student[0] for student in top_students))


# Print subject-wise toppers
for subject in sorted(subject_topper):
    records = subject_topper[subject]
    highest = max(mark for mark, enrollment in records)

    toppers = sorted(
        enrollment for mark, enrollment in records
        if mark == highest
    )

    print(subject + ":", " ".join(toppers))
