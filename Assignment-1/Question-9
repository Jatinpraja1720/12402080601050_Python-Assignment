import heapq

w, n = map(int, input().split())

jobs = []

for i in range(n):
    arrival, job_id, priority, duration, resources = input().split()

    arrival = int(arrival)
    priority = int(priority)
    duration = int(duration)
    resources = int(resources)

    jobs.append((arrival, i, job_id, priority, duration, resources))

jobs.sort()

workers = [(0, i + 1) for i in range(w)]
heapq.heapify(workers)

waiting_time = 0
result = []

i = 0
current_time = 0

while i < n:
    if current_time < jobs[i][0]:
        current_time = jobs[i][0]

    available_jobs = []

    while i < n and jobs[i][0] <= current_time:
        arrival, order, job_id, priority, duration, resources = jobs[i]
        heapq.heappush(
            available_jobs,
            (-priority, arrival, order, job_id, duration, resources)
        )
        i += 1

    worker_free, worker_id = heapq.heappop(workers)

    if worker_free > current_time:
        current_time = worker_free

        while i < n and jobs[i][0] <= current_time:
            arrival, order, job_id, priority, duration, resources = jobs[i]
            heapq.heappush(
                available_jobs,
                (-priority, arrival, order, job_id, duration, resources)
            )
            i += 1

    if available_jobs:
        priority, arrival, order, job_id, duration, resources = heapq.heappop(
            available_jobs
        )

        start = max(current_time, worker_free)
        finish = start + duration

        waiting_time += start - arrival

        result.append((start, job_id, worker_id, finish))
        heapq.heappush(workers, (finish, worker_id))

        current_time = start
    else:
        current_time += 1

for start, job_id, worker_id, finish in sorted(result, key=lambda x: x[0]):
    print(job_id, "W" + str(worker_id), start, finish)

print("AVG_WAIT", round(waiting_time / n, 2))
