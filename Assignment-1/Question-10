import tkinter as tk
from tkinter import messagebox
import json
import csv

FILE = "assignments.json"


def load_data():
    try:
        with open(FILE, "r") as file:
            return json.load(file)
    except:
        return []


data = load_data()


def save_data():
    with open(FILE, "w") as file:
        json.dump(data, file, indent=4)


def add_submission():
    enrollment = entry_enrollment.get().strip()
    name = entry_name.get().strip()
    assignment = entry_assignment.get().strip()
    marks = entry_marks.get().strip()
    status = status_var.get()

    if not enrollment or not name or not assignment:
        messagebox.showerror("Error", "Please fill all details")
        return

    if marks:
        try:
            marks = int(marks)
        except:
            messagebox.showerror("Error", "Marks must be a number")
            return
    else:
        marks = ""

    record = {
        "enrollment": enrollment,
        "name": name,
        "assignment": assignment,
        "status": status,
        "marks": marks
    }

    data.append(record)
    save_data()

    messagebox.showinfo("Success", "Submission added")
    clear_fields()
    show_data()


def clear_fields():
    entry_enrollment.delete(0, tk.END)
    entry_name.delete(0, tk.END)
    entry_assignment.delete(0, tk.END)
    entry_marks.delete(0, tk.END)


def show_data():
    listbox.delete(0, tk.END)

    for item in data:
        text = (
            item["enrollment"] + " | " +
            item["name"] + " | " +
            item["assignment"] + " | " +
            item["status"] + " | " +
            str(item["marks"])
        )
        listbox.insert(tk.END, text)


def filter_data():
    choice = filter_var.get()
    listbox.delete(0, tk.END)

    for item in data:
        if choice == "ALL" or item["status"] == choice:
            text = (
                item["enrollment"] + " | " +
                item["name"] + " | " +
                item["assignment"] + " | " +
                item["status"] + " | " +
                str(item["marks"])
            )
            listbox.insert(tk.END, text)


def export_csv():
    with open("assignment_report.csv", "w", newline="") as file:
        writer = csv.writer(file)

        writer.writerow([
            "Enrollment",
            "Name",
            "Assignment",
            "Status",
            "Marks"
        ])

        for item in data:
            writer.writerow([
                item["enrollment"],
                item["name"],
                item["assignment"],
                item["status"],
                item["marks"]
            ])

    messagebox.showinfo("Success", "CSV report created")


root = tk.Tk()
root.title("Assignment Tracker")
root.geometry("700x500")

tk.Label(root, text="Enrollment").pack()
entry_enrollment = tk.Entry(root)
entry_enrollment.pack()

tk.Label(root, text="Name").pack()
entry_name = tk.Entry(root)
entry_name.pack()

tk.Label(root, text="Assignment").pack()
entry_assignment = tk.Entry(root)
entry_assignment.pack()

tk.Label(root, text="Marks").pack()
entry_marks = tk.Entry(root)
entry_marks.pack()

status_var = tk.StringVar(value="Pending")

tk.Radiobutton(
    root, text="Pending", variable=status_var, value="Pending"
).pack()

tk.Radiobutton(
    root, text="Completed", variable=status_var, value="Completed"
).pack()

tk.Button(
    root, text="Add Submission", command=add_submission
).pack(pady=5)

filter_var = tk.StringVar(value="ALL")

tk.OptionMenu(
    root, filter_var, "ALL", "Pending", "Completed",
    command=lambda x: filter_data()
).pack()

tk.Button(
    root, text="Export CSV", command=export_csv
).pack(pady=5)

listbox = tk.Listbox(root, width=90, height=12)
listbox.pack(pady=10)

show_data()

root.mainloop()
